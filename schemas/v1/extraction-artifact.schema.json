{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.local/schemas/v1/extraction-artifact.schema.json",
  "title": "Extraction artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "extractor", "pages", "plain_text"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source_id": { "type": "string", "minLength": 1 },
    "extractor": { "type": "string", "minLength": 1 },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_number", "markdown"],
        "properties": {
          "page_number": { "type": "integer", "minimum": 1 },
          "markdown": { "type": "string" },
          "layout_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "plain_text": { "type": "string" }
  }
}
