{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.local/schemas/v1/job.schema.json",
  "title": "Ingest job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "wiki_id",
    "state",
    "stage_progress",
    "created_at",
    "updated_at",
    "checkpoints"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "job_id": { "type": "string", "minLength": 1 },
    "wiki_id": { "type": "string", "minLength": 1 },
    "state": { "$ref": "#/$defs/jobState" },
    "stage_progress": { "type": "number", "minimum": 0, "maximum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "completed_at"],
        "properties": {
          "state": { "$ref": "#/$defs/jobState" },
          "completed_at": { "type": "string", "format": "date-time" },
          "artifact_path": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "jobState": {
      "enum": [
        "queued",
        "acquiring",
        "extracting",
        "ingesting",
        "validating",
        "staging",
        "publishing",
        "completed",
        "needs_review",
        "cancelled",
        "failed"
      ]
    }
  }
}
